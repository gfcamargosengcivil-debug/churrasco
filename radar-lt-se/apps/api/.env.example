# Copie para apps/api/.env (ignorado pelo git). NUNCA versione credenciais reais.

NODE_ENV=development
PORT=3333
LOG_LEVEL=info

# Persistência: memoria (arquivo JSON local, para avaliação) | postgres (produção, PostGIS)
PERSISTENCIA=memoria
ARQUIVO_DADOS=data/radar.json
# DATABASE_URL=postgres://usuario:senha@host:5432/radar
# DATABASE_SSL=true

# Autenticação: dev (sem login; proibido com NODE_ENV=production) | supabase
AUTH_MODE=dev
# SUPABASE_URL=https://<projeto>.supabase.co          # valida JWT via JWKS
# SUPABASE_JWT_SECRET=                                 # alternativa: segredo HS256 do projeto
# SUPABASE_JWT_AUDIENCE=authenticated
# Papel atribuído quando o token não traz app_metadata.role (admin|analista|comercial|leitor)
PAPEL_PADRAO=leitor
CORS_ORIGINS=http://localhost:5173

# Carrega dados DEMONSTRATIVOS FICTÍCIOS se a base estiver vazia (desligue em produção)
DEMO_AUTOCARGA=true
# Agendador dentro da API (modo memória). Em modo postgres use o worker (npm run worker).
AGENDADOR=true

# IA documental (opcional; sem chave usa extração heurística). Custos por uso na API da Anthropic.
# ANTHROPIC_API_KEY=
# IA_MODELO=claude-opus-5-5
# IA_LIMITE_CARACTERES=400000

# Servir o front compilado pela própria API (produção)
# WEB_DIST=../web/dist

# Diário Oficial da União — INLABS (cadastro gratuito na Imprensa Nacional; download ainda não implementado)
# INLABS_EMAIL=
# INLABS_SENHA=

# Envio de alertas por e-mail (pendente de implementação; alertas no app funcionam sem isto)
# SMTP_URL=smtp://usuario:senha@host:587
