# Copie para apps/web/.env.local (ignorado pelo git). Somente variáveis PÚBLICAS: tudo com VITE_
# vai para o navegador. Nunca coloque aqui chaves secretas (Anthropic, service_role, banco).

# URL da API quando servida em outro domínio (vazio = mesma origem / proxy do Vite)
# VITE_API_URL=https://api.exemplo.com.br
# Destino do proxy /api no desenvolvimento (padrão http://localhost:3333)
# VITE_API_PROXY=http://localhost:3333

# Login com Supabase Auth (a chave anon é pública por desenho; o acesso é controlado por RLS/JWT)
# VITE_SUPABASE_URL=https://<projeto>.supabase.co
# VITE_SUPABASE_ANON_KEY=

# Mapa base (padrão OpenStreetMap — respeite a política de uso de tiles; para uso intenso contrate um provedor)
# VITE_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=&copy; colaboradores do OpenStreetMap
